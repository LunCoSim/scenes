#usda 1.0
(
    defaultPrim = "HoloPylonWaypoint"
    upAxis = "Y"
    metersPerUnit = 1
)

# Reusable mission waypoint marker, rendered as a PULSING HOLOGRAPHIC PYLON.
#
# Functionally identical to `vessels/markers/waypoint.usda`: a `LunCoWaypointAPI`
# root plus an invisible, ground-anchored overlap trigger
# (`lunco:triggerZone = "waypoint"`) whose Sensor drives the canonical
# `waypoint.reached {path,state,index}` event. Only the VISUAL differs.
#
# The visual is a set of concentric UNIT cylinders + a foot ring + a node,
# every one bound to `holo_pylon.wgsl`. That shader cuts the tube into
# spiralling energy blades and masks the rest to a rotating lattice + travelling
# rings + fresnel rim, so nothing reads as the cylinder it is. Two-toned:
# the purple/pink Cage+Aura only reach halfway up the pylon's full 4.8 m
# height (doubled from the original 2.4 m) — the bare cyan Core lance and
# its Node finial keep rising to the full height above them. The foot ring
# stays put at ground scale.
#
# Drop it in with `prepend references` + `xformOp:translate`, exactly like
# `waypoint.usda`.
def Xform "HoloPylonWaypoint" (
    doc = "Waypoint marker drawn as a pulsing holographic pylon; identical arrival-trigger contract to waypoint.usda."
    prepend apiSchemas = ["LunCoCatalogAPI", "LunCoWaypointAPI"]
    kind = "component"
)
{
    uniform bool lunco:spawnable = true
    bool lunco:waypoint = true
    custom string lunco:interaction:left = "pass_through"
    custom string lunco:interaction:right = "context"

    # Authored inactive colour — read by the shared Rhai waypoint helper only if
    # a mission opts into re-tinting reached markers. This mission does not.
    float3 lunco:waypoint:inactiveColor = (0.10, 0.32, 0.36)

    def Scope "Looks"
    {
        # Bladed cage — the spiralling blades + lattice + rings. The main event.
        def Material "Cage_Mat"
        {
            token outputs:surface.connect = </HoloPylonWaypoint/Looks/Cage_Mat/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @twin://my-survey/holo_pylon.wgsl@
                # Spiralling energy blades — purple.
                color3f inputs:color = (1.6, 0.15, 2.5)
                float inputs:glow = 2.6
                float inputs:base_alpha = 0.04
                float inputs:base_floor = 0.03
                float inputs:blades = 5.0
                float inputs:blade_gap = 0.56
                float inputs:blade_twist = 0.5
                float inputs:rim_gain = 0.55
                float inputs:ring_gain = 1.3
                float inputs:lattice_gain = 0.85
                float inputs:sweep_gain = 0.7
                float inputs:hot_edge = 0.9
                token outputs:surface
            }
        }

        # Solid-looking core lance up the middle.
        def Material "Core_Mat"
        {
            token outputs:surface.connect = </HoloPylonWaypoint/Looks/Core_Mat/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @twin://my-survey/holo_pylon.wgsl@
                # Inner core lance — deep blue, the palm "trunk". Was cyan;
                # the outrun reference has no cyan in it at all.
                color3f inputs:color = (0.06, 0.14, 1.15)
                float inputs:glow = 2.3
                float inputs:base_alpha = 0.75
                float inputs:base_floor = 0.85
                float inputs:blades = 0.0
                float inputs:rim_gain = 0.2
                float inputs:ring_gain = 0.45
                float inputs:ring_count = 6.0
                float inputs:lattice_gain = 0.0
                float inputs:sweep_gain = 0.0
                float inputs:hot_edge = 0.5
                token outputs:surface
            }
        }

        # Pure fresnel bloom — the wide aura and the foot ring.
        def Material "Aura_Mat"
        {
            token outputs:surface.connect = </HoloPylonWaypoint/Looks/Aura_Mat/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @twin://my-survey/holo_pylon.wgsl@
                # Outer aura + foot ring — purple, to sit with the blades.
                color3f inputs:color = (1.3, 0.12, 2.2)
                float inputs:glow = 1.7
                float inputs:base_alpha = 0.0
                float inputs:base_floor = 0.0
                float inputs:blades = 6.0
                float inputs:blade_gap = 0.5
                float inputs:blade_twist = 0.0
                float inputs:rim_gain = 1.1
                float inputs:rim_power = 2.2
                float inputs:ring_gain = 0.35
                float inputs:ring_count = 4.0
                float inputs:lattice_gain = 0.0
                float inputs:sweep_gain = 0.0
                float inputs:hot_edge = 0.0
                token outputs:surface
            }
        }
        def Material "Frond_Mat"
        {
            token outputs:surface.connect = </HoloPylonWaypoint/Looks/Frond_Mat/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:wgsl:sourceAsset = @twin://my-survey/holo_pylon.wgsl@
                color3f inputs:color = (0.05, 2.6, 0.1)
                float inputs:glow = 3.0
                float inputs:base_alpha = 0.15
                float inputs:base_floor = 0.05
                float inputs:blades = 3.0
                float inputs:blade_gap = 0.4
                float inputs:blade_twist = 1.0
                float inputs:blade_soft = 0.08
                float inputs:rim_gain = 0.7
                float inputs:rim_power = 2.0
                float inputs:ring_gain = 3.0
                float inputs:ring_count = 3.0
                float inputs:ring_speed = 2.2
                float inputs:ring_sharp = 5.0
                float inputs:lattice_gain = 1.0
                float inputs:lattice_cells = 5.0
                float inputs:lattice_spin = 1.2
                float inputs:sweep_gain = 2.0
                float inputs:glitch = 0.30
                float inputs:sweep_speed = 3.0
                float inputs:scanline = 0.15
                float inputs:glitch = 0.15
                float inputs:hot_edge = 0.6
                float inputs:top_fade = 0.15
                float inputs:bottom_fade = 0.05
                token outputs:surface
            }
        }
    }

    # ── Visual pieces — UNIT primitives, sized by xformOp:scale, dressed
    #    entirely by the shader. `lunco:surface:additive` + a sub-1
    #    `displayOpacity` select the blend pipeline; no collision, no shadow —
    #    these are annotations, not scenery.

    # Bright core lance (solid, no blades).
    def Cylinder "Core" (
        prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"]
    )
    {
        uniform token axis = "Y"
        double radius = 1.0
        double height = 1.0
        double3 xformOp:translate = (0, 3.6, 0)
        double3 xformOp:scale = (0.085, 7.2, 0.085)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </HoloPylonWaypoint/Looks/Core_Mat>
        color3f[] primvars:displayColor = [(0.10, 0.22, 0.85)]
        float[] primvars:displayOpacity = [0.7]
        bool lunco:surface:additive = true
        bool physics:collisionEnabled = false
        bool primvars:doNotCastShadows = true
    }

    # Spiralling bladed cage — tall and slim. Purple/pink, so only reaches
    # the halfway point of the pylon's full (cyan Core/Node) height — the
    # bare cyan lance keeps rising above it.
    def Cylinder "Cage" (
        prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"]
    )
    {
        uniform token axis = "Y"
        double radius = 1.0
        double height = 1.0
        double3 xformOp:translate = (0, 1.8, 0)
        double3 xformOp:scale = (0.42, 3.6, 0.42)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </HoloPylonWaypoint/Looks/Cage_Mat>
        color3f[] primvars:displayColor = [(0.55, 0.2, 1.0)]
        float[] primvars:displayOpacity = [0.5]
        bool lunco:surface:additive = true
        bool physics:collisionEnabled = false
        bool primvars:doNotCastShadows = true
    }

    # Soft outer aura. Purple/pink, halved along with the Cage.
    def Cylinder "Aura" (
        prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"]
    )
    {
        uniform token axis = "Y"
        double radius = 1.0
        double height = 1.0
        double3 xformOp:translate = (0, 1.875, 0)
        double3 xformOp:scale = (0.6, 3.75, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </HoloPylonWaypoint/Looks/Aura_Mat>
        color3f[] primvars:displayColor = [(0.55, 0.2, 1.0)]
        float[] primvars:displayOpacity = [0.22]
        bool lunco:surface:additive = true
        bool physics:collisionEnabled = false
        bool primvars:doNotCastShadows = true
    }

    # Glowing hoop standing on the ground (a vertical band, not a flat plate).
    def Cylinder "FootRing" (
        prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"]
    )
    {
        uniform token axis = "Y"
        double radius = 1.0
        double height = 1.0
        double3 xformOp:translate = (0, 0.3, 0)
        double3 xformOp:scale = (0.8, 0.6, 0.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </HoloPylonWaypoint/Looks/Aura_Mat>
        color3f[] primvars:displayColor = [(0.55, 0.2, 1.0)]
        float[] primvars:displayOpacity = [0.55]
        bool lunco:surface:additive = true
        bool physics:collisionEnabled = false
        bool primvars:doNotCastShadows = true
    }

    # Finial node at the tip.
    def Sphere "Node" (
        prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"]
    )
    {
        double radius = 0.13
        double3 xformOp:translate = (0, 7.38, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </HoloPylonWaypoint/Looks/Core_Mat>
        color3f[] primvars:displayColor = [(0.35, 0.5, 1.0)]
        float[] primvars:displayOpacity = [0.9]
        bool lunco:surface:additive = true
        bool physics:collisionEnabled = false
        bool primvars:doNotCastShadows = true
    }

    # Invisible ground-anchored arrival trigger — verbatim from waypoint.usda.
    # This is the prim that fires `waypoint.reached`.
    def Sphere "Trigger" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double radius = 2.5
        token visibility = "invisible"
        bool physics:collisionEnabled = true
        custom string lunco:triggerZone = "waypoint"
    }

    # ── PALM CROWN ─────────────────────────────────────────────
    #    Merged in from my_survey.usda so the whole palm — pylon body AND
    #    crown — is ONE portable asset. It used to live as a separate
    #    `/Survey/Prototypes/FrondCluster` prototype that each RoadPylon
    #    referenced as a second arc; the geometry is unchanged.
    def Xform "Fronds"
    {

        def Xform "Frond1"
        {
            double3 xformOp:translate = (0, 7.35, 0)
            double3 xformOp:rotateXYZ = (0, 1.1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

            def Xform "Seg1"
            {
                double3 xformOp:rotateXYZ = (64.3, -3.1, 0.0)
                uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

                def Cube "Blade" ( prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"] )
                {
                    double size = 1.0
                    double3 xformOp:translate = (0, 0.2942, 0)
                    double3 xformOp:scale = (0.05, 0.5885, 0.05)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    rel material:binding = </HoloPylonWaypoint/Looks/Frond_Mat>
                    color3f[] primvars:displayColor = [(0.05, 2.6, 0.1)]
                    bool physics:collisionEnabled = false
                    bool primvars:doNotCastShadows = true
                }

                def Xform "Seg2"
                {
                    double3 xformOp:translate = (0, 0.5884816107223234, 0)
                    double3 xformOp:rotateXYZ = (21.8, 2.5, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

                    def Cube "Blade" ( prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"] )
                    {
                        double size = 1.0
                        double3 xformOp:translate = (0, 0.3294, 0)
                        double3 xformOp:scale = (0.05, 0.6588, 0.05)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                        rel material:binding = </HoloPylonWaypoint/Looks/Frond_Mat>
                        color3f[] primvars:displayColor = [(0.05, 2.6, 0.1)]
                        bool physics:collisionEnabled = false
                        bool primvars:doNotCastShadows = true
                    }

                    def Xform "Seg3"
                    {
                        double3 xformOp:translate = (0, 0.6588269351557269, 0)
                        double3 xformOp:rotateXYZ = (21.2, -1.1, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

                        def Cube "Blade" ( prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"] )
                        {
                            double size = 1.0
                            double3 xformOp:translate = (0, 0.2347, 0)
                            double3 xformOp:scale = (0.05, 0.4695, 0.05)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                            rel material:binding = </HoloPylonWaypoint/Looks/Frond_Mat>
                            color3f[] primvars:displayColor = [(0.05, 2.6, 0.1)]
                            bool physics:collisionEnabled = false
                            bool primvars:doNotCastShadows = true
                        }
                    }
                }
            }
        }
        def Xform "Frond2"
        {
            double3 xformOp:translate = (0, 7.35, 0)
            double3 xformOp:rotateXYZ = (0, 17.7, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

            def Xform "Seg1"
            {
                double3 xformOp:rotateXYZ = (69.1, -6.6, 0.0)
                uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

