                {
                    double size = 1.0
                    double3 xformOp:translate = (0, 0.2924, 0)
                    double3 xformOp:scale = (0.05, 0.5848, 0.05)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    rel material:binding = </HoloPylonWaypoint/Looks/Frond_Mat>
                    color3f[] primvars:displayColor = [(0.05, 2.6, 0.1)]
                    bool physics:collisionEnabled = false
                    bool primvars:doNotCastShadows = true
                }

                def Xform "Seg2"
                {
                    double3 xformOp:translate = (0, 0.5848256476029973, 0)
                    double3 xformOp:rotateXYZ = (20.8, 0.6, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

                    def Cube "Blade" ( prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"] )
                    {
                        double size = 1.0
                        double3 xformOp:translate = (0, 0.2790, 0)
                        double3 xformOp:scale = (0.05, 0.5581, 0.05)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                        rel material:binding = </HoloPylonWaypoint/Looks/Frond_Mat>
                        color3f[] primvars:displayColor = [(0.05, 2.6, 0.1)]
                        bool physics:collisionEnabled = false
                        bool primvars:doNotCastShadows = true
                    }

                    def Xform "Seg3"
                    {
                        double3 xformOp:translate = (0, 0.5580660933061046, 0)
                        double3 xformOp:rotateXYZ = (28.2, 4.3, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

                        def Cube "Blade" ( prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"] )
                        {
                            double size = 1.0
                            double3 xformOp:translate = (0, 0.2330, 0)
                            double3 xformOp:scale = (0.05, 0.4660, 0.05)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                            rel material:binding = </HoloPylonWaypoint/Looks/Frond_Mat>
