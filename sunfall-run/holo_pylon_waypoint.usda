            }
        }
        def Xform "Frond5"
        {
            double3 xformOp:translate = (0, 7.35, 0)
            double3 xformOp:rotateXYZ = (0, 81.6, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

            def Xform "Seg1"
            {
                double3 xformOp:rotateXYZ = (64.5, -3.8, 0.0)
                uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

                def Cube "Blade" ( prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"] )
                {
                    double size = 1.0
                    double3 xformOp:translate = (0, 0.2992, 0)
                    double3 xformOp:scale = (0.05, 0.5984, 0.05)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                    rel material:binding = </HoloPylonWaypoint/Looks/Frond_Mat>
                    color3f[] primvars:displayColor = [(0.05, 2.6, 0.1)]
                    bool physics:collisionEnabled = false
                    bool primvars:doNotCastShadows = true
                }

                def Xform "Seg2"
                {
                    double3 xformOp:translate = (0, 0.598408194540316, 0)
                    double3 xformOp:rotateXYZ = (14.0, -3.7, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

                    def Cube "Blade" ( prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"] )
                    {
                        double size = 1.0
                        double3 xformOp:translate = (0, 0.2701, 0)
                        double3 xformOp:scale = (0.05, 0.5402, 0.05)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                        rel material:binding = </HoloPylonWaypoint/Looks/Frond_Mat>
                        color3f[] primvars:displayColor = [(0.05, 2.6, 0.1)]
                        bool physics:collisionEnabled = false
                        bool primvars:doNotCastShadows = true
                    }

                    def Xform "Seg3"
                    {
                        double3 xformOp:translate = (0, 0.5401502144114594, 0)
                        double3 xformOp:rotateXYZ = (23.9, 1.9, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

                        def Cube "Blade" ( prepend apiSchemas = ["MaterialBindingAPI", "LunCoSurfaceAPI"] )
                        {
                            double size = 1.0
