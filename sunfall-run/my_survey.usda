        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Trigger" { bool physics:collisionEnabled = false }

    }
    # ── THE FLAME GATE (pair 5) ──────────────────────────────────────────
    #    The two palms that stood here are gone; these are cannons. They sit
    #    one gate BEFORE the midpoint on purpose: the Avatar camera watches
    #    down the road from (10, 5, 74), so a burst at z = -23.55 happens in
    #    frame instead of somewhere off past the horizon.
    #
    #    The right cannon is yawed 180 deg so its barrel (authored along +X)
    #    faces back across the carriageway — the pair fire into each other
    #    over the rover as it passes between them. No trigger override here:
    #    holo_cannon.usda carries no waypoint Sensor, unlike the pylons.
    def Xform "RoadCannon_L5" ( prepend references = @twin://my-survey/holo_cannon.usda@</HoloCannon> )
    {
        double3 xformOp:translate = (-10, 0.0, -23.55)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        # The flame's gate reads the rover's road position: its body's
        # `position_z` port, mapped onto 0..1 on the wire (z -200..200 ->
        # 0..1; pure unit conversion, no sign) because a shader input is
        # declared 0..1. Dark at load (rover at z=60.45), igniting from
        # z=+1.45 (fully out by -2.55) to z=-29.0 — see Flame_Mat in
        # holo_cannon.usda.
        over "Flame"
        {
            float inputs:rover_level.connect = </Survey/SurveyRover.outputs:position_z>
            float lunco:factor:rover_level = 0.0025
            float lunco:offset:rover_level = 0.5
        }
    }
    def Xform "RoadCannon_R5" ( prepend references = @twin://my-survey/holo_cannon.usda@</HoloCannon> )
    {
        double3 xformOp:translate = (10, 0.0, -23.55)
        double3 xformOp:rotateXYZ = (0, 180, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        # The flame's gate reads the rover's road position: its body's
        # `position_z` port, mapped onto 0..1 on the wire (z -200..200 ->
        # 0..1; pure unit conversion, no sign) because a shader input is
        # declared 0..1. Dark at load (rover at z=60.45), igniting from
        # z=+1.45 (fully out by -2.55) to z=-29.0 — see Flame_Mat in
        # holo_cannon.usda.
        over "Flame"
        {
            float inputs:rover_level.connect = </Survey/SurveyRover.outputs:position_z>
            float lunco:factor:rover_level = 0.0025
            float lunco:offset:rover_level = 0.5
        }
    }
    def Xform "RoadPylon_L6" ( prepend references = @twin://my-survey/holo_pylon_waypoint.usda@</HoloPylonWaypoint> )
    {
        double3 xformOp:translate = (-10, 0.0, -43.55)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Trigger" { bool physics:collisionEnabled = false }

    }
    def Xform "RoadPylon_R6" ( prepend references = @twin://my-survey/holo_pylon_waypoint.usda@</HoloPylonWaypoint> )
    {
        double3 xformOp:translate = (10, 0.0, -43.55)
        uniform token[] xformOpOrder = ["xformOp:translate"]
