    def Xform "RoadPylon_L9" ( prepend references = @twin://my-survey/holo_pylon_waypoint.usda@</HoloPylonWaypoint> )
    {
        double3 xformOp:translate = (-10, 0.0, -103.55)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Trigger" { bool physics:collisionEnabled = false }

    }
    def Xform "RoadPylon_R9" ( prepend references = @twin://my-survey/holo_pylon_waypoint.usda@</HoloPylonWaypoint> )
    {
