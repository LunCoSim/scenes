    }
    def Xform "RoadPylon_L10" ( prepend references = @twin://my-survey/holo_pylon_waypoint.usda@</HoloPylonWaypoint> )
    {
        double3 xformOp:translate = (-10, 0.0, -123.55)
        uniform token[] xformOpOrder = ["xformOp:translate"]
