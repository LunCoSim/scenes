    # ── The road: a straight 196 m run down local -Z (the rover's own nose
    #    direction — see HoodWedge), from z=47 to z=-149, stopping clear of the sun sphere (whose
    #    ground footprint starts at z=-154.6) and 51 m short of the grid edge. Three functional
    #    checkpoints sit on the centreline (x=0) — same `drive_to` targets
    #    `survey_patrol.btxml` already points at, each level with a pylon
    #    pair (z=47 / -53 / -149, i.e. pylons 1, 6 and 11). The last
            #    pair sits ON the grid edge — the ground is 400 m square, so
            #    anything past z=-200 hangs in the air. No
    #    marker geometry of their own any more — the centreline itself is
    #    the marker (see `Grid_Mat`'s glowing yellow-orange spine, drawn by
    #    `neon_grid.wgsl`, replacing what used to be discrete reflector
    #    dots). ──
    def Xform "Waypoint1" (
        prepend apiSchemas = ["LunCoCatalogAPI", "LunCoWaypointAPI"]
    )
    {
        uniform bool lunco:spawnable = false
        bool lunco:waypoint = true
        double3 xformOp:translate = (0.0, 0.0, 56.45)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Sphere "Trigger" ( prepend apiSchemas = ["PhysicsCollisionAPI"] )
        {
            double radius = 2.5
            token visibility = "invisible"
            bool physics:collisionEnabled = true
            custom string lunco:triggerZone = "waypoint"
        }
    }
    def Xform "Waypoint2" (
        prepend apiSchemas = ["LunCoCatalogAPI", "LunCoWaypointAPI"]
    )
    {
        uniform bool lunco:spawnable = false
        bool lunco:waypoint = true
        double3 xformOp:translate = (0.0, 0.0, -13.55)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Sphere "Trigger" ( prepend apiSchemas = ["PhysicsCollisionAPI"] )
        {
            double radius = 4.5
            token visibility = "invisible"
            bool physics:collisionEnabled = true
            custom string lunco:triggerZone = "waypoint"
        }
    }
    def Xform "Waypoint3" (
        prepend apiSchemas = ["LunCoCatalogAPI", "LunCoWaypointAPI"]
    )
    {
        uniform bool lunco:spawnable = false
        bool lunco:waypoint = true
        double3 xformOp:translate = (0.0, 0.0, -33.55)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Sphere "Trigger" ( prepend apiSchemas = ["PhysicsCollisionAPI"] )
        {
            double radius = 4.5
            token visibility = "invisible"
            bool physics:collisionEnabled = true
            custom string lunco:triggerZone = "waypoint"
        }
    }
    # ── THE FINISH — INSIDE THE SUN ──────────────────────────────────────
    #    `SunsetSun` is centred at (0, 23.166, -170) with radius 25.74, so at
    #    ground level it is a circle of radius sqrt(25.74^2 - 23.166^2) =
    #    11.22 m: the road enters the sphere at z = -158.8 and leaves it at
    #    z = -181.2. This gate sits at the centre of that chord, so arriving
    #    means you are INSIDE the sun, not merely near it. The disc is
    #    `doubleSided` and has no collider precisely so you can drive in.
    #
    #    Radius 4.0, not the 2.5 the road gates use: this is the finish and it
    #    is approached through blinding light, so it is made easy to hit.
    def Xform "Waypoint4" (
        prepend apiSchemas = ["LunCoCatalogAPI", "LunCoWaypointAPI"]
    )
    {
        uniform bool lunco:spawnable = false
        bool lunco:waypoint = true
        double3 xformOp:translate = (0.0, 0.0, -170.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Sphere "Trigger" ( prepend apiSchemas = ["PhysicsCollisionAPI"] )
        {
            double radius = 4.0
            token visibility = "invisible"
            bool physics:collisionEnabled = true
            custom string lunco:triggerZone = "waypoint"
        }
    }

    # Decorative-only twins (Trigger disabled) lining both sides of the road,
